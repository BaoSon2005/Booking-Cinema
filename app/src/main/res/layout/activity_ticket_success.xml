<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Tiêu đề -->
        <TextView
            android:text="🎟️ Vé Xem Phim"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#E50914"
            android:layout_marginBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Khung vé -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/ticket_background"
            android:padding="20dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/tvMovieTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tên phim"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvCinema"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rạp: "
                android:textSize="16sp"
                android:layout_marginBottom="6dp"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/tvShowtime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Suất: "
                android:textSize="16sp"
                android:layout_marginBottom="6dp"
                android:textColor="#444444" />

            <TextView
                android:id="@+id/tvSeat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ghế: "
                android:textSize="16sp"
                android:layout_marginBottom="6dp"
                android:textColor="#444444" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tổng tiền: "
                android:textSize="16sp"
                android:layout_marginBottom="6dp"
                android:textColor="#444444" />

            <TextView
                android:id="@+id/tvPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thanh toán: "
                android:textSize="16sp"
                android:layout_marginBottom="6dp"
                android:textColor="#444444" />

            <TextView
                android:id="@+id/tvTicketCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mã vé: "
                android:textSize="16sp"
                android:textStyle="italic"
                android:textColor="#777777"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Nút xác nhận -->
        <Button
            android:id="@+id/btnConfirmTicket"
            android:layout_marginTop="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xác nhận"
            android:backgroundTint="#E50914"
            android:textColor="#FFFFFF"
            android:padding="14dp" />

    </LinearLayout>
</ScrollView>
