<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <!-- Tiêu đề -->
        <TextView
            android:text="🔖 Xác nhận thanh toán"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:layout_marginBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Ghế đã chọn -->
        <TextView
            android:id="@+id/tvSelectedSeats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ghế đã chọn: "
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="8dp" />

        <!-- Tổng tiền -->
        <TextView
            android:id="@+id/txtTotalPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tổng tiền: 0₫"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#E64A19"
            android:layout_marginBottom="16dp" />

        <!-- Nhập mã giảm giá -->
        <EditText
            android:id="@+id/edtDiscountCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="🎁 Nhập mã giảm giá"
            android:inputType="text"
            android:padding="12dp"
            android:background="@drawable/bg_edittext"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <!-- Nút áp dụng -->
        <Button
            android:id="@+id/btnApplyCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Áp dụng mã"
            android:textAllCaps="false"
            android:layout_gravity="end"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Danh sách mã giảm giá -->
        <ListView
            android:id="@+id/lvDiscountCodes"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:divider="@android:color/darker_gray"
            android:dividerHeight="1dp"
            android:visibility="gone"
            android:background="#F5F5F5"
            android:layout_marginBottom="24dp" />

        <!-- Họ tên -->
        <EditText
            android:id="@+id/edtName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="👤 Gmail"
            android:inputType="textPersonName"
            android:textColor="#000000"
            android:padding="12dp"
            android:background="@drawable/bg_edittext"
            android:layout_marginBottom="12dp" />

        <!-- Số điện thoại -->
        <EditText
            android:id="@+id/edtPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="📞 Số điện thoại"
            android:inputType="phone"
            android:padding="12dp"
            android:textColor="#000000"
            android:background="@drawable/bg_edittext"
            android:layout_marginBottom="24dp" />

        <!-- Thanh toán -->
        <TextView
            android:text="💳 Phương thức thanh toán"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <ListView
            android:id="@+id/lvPaymentMethods"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:divider="@color/cardview_dark_background"
            android:dividerHeight="1dp"
            android:choiceMode="singleChoice"
            android:background="#F5F5F5"
            android:layout_marginBottom="24dp" />

        <!-- Mã QR -->
        <ImageView
            android:id="@+id/ivQRCode"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:contentDescription="Mã QR thanh toán"
            android:visibility="gone"
            android:layout_marginBottom="24dp" />

        <!-- Nút Thanh toán -->
        <Button
            android:id="@+id/btnPay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ Thanh toán ngay"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:padding="14dp" />
    </LinearLayout>
</ScrollView>
