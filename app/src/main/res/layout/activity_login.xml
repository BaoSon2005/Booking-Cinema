<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_top_bar_luxe"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CINE-LUXE"
                    android:textColor="#FF0033"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_icon_circle_luxe"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="#FF0033"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#0D0D0D"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chào mừng trở lại"
                        android:textColor="#FF0033"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Đăng nhập để đặt vé, giữ ghế, nhận voucher và tích điểm thành viên."
                        android:textColor="#B8B8B8"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtUsername"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_input_luxe"
                        android:hint="Email thành viên"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#B8B8B8"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtPassword"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_luxe"
                        android:hint="Mật khẩu"
                        android:inputType="textPassword"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#B8B8B8"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvForgot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="9dp"
                        android:text="Quên mật khẩu?"
                        android:textColor="#FF0033"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_button_neon"
                        android:text="ĐĂNG NHẬP"
                        android:textAllCaps="true"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#1AFFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Đăng nhập nhanh"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnGoogle"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_button_outline"
                        android:text="Tiếp tục với Google"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtPhone"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_luxe"
                        android:hint="Số điện thoại, ví dụ +84901234567"
                        android:inputType="phone"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#B8B8B8"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnPhoneLogin"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_button_outline"
                        android:text="Gửi mã OTP"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtOtp"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_luxe"
                        android:hint="Mã OTP"
                        android:inputType="number"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#B8B8B8"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnVerifyPhone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_button_neon"
                        android:text="XÁC MINH SỐ ĐIỆN THOẠI"
                        android:textAllCaps="true"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#0D0D0D"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/bg_icon_circle_luxe"
                        android:gravity="center"
                        android:text="FaceID"
                        android:textColor="#FF0033"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnBiometric"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_button_outline"
                        android:text="Xác thực khuôn mặt (FaceID)"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvSignUp"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_panel_glass"
                android:gravity="center"
                android:text="Chưa có tài khoản? Đăng ký ngay"
                android:textColor="#FF0033"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressAuth"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="#FF0033"
        android:visibility="gone" />
</FrameLayout>
