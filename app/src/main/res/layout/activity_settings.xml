<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cinema_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_top_bar_luxe"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="☰"
            android:textColor="@color/cinema_text_muted"
            android:textSize="18sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CINE-LUXE"
            android:textColor="@color/cinema_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_icon_circle_luxe"
            android:gravity="center"
            android:text="●"
            android:textColor="@color/cinema_accent"
            android:textSize="11sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tài khoản"
                android:textColor="@color/cinema_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/cinema_panel"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/cinema_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgAvatar"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/avatar_circle_bg"
                            android:contentDescription="Ảnh đại diện"
                            android:padding="4dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_profile" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvUserName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Khách CINE-LUXE"
                                android:textColor="@color/cinema_text"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvUserEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="email@example.com"
                                android:textColor="@color/cinema_text_muted"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_voucher_luxe"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvMemberRank"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Hạng thành viên: Ruby"
                                android:textColor="@color/cinema_text"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvVipPoint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Điểm tích lũy: 0"
                                android:textColor="@color/cinema_accent"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imgPersonalQr"
                            android:layout_width="82dp"
                            android:layout_height="82dp"
                            android:background="@drawable/bg_qr_frame"
                            android:contentDescription="QR thành viên"
                            android:padding="5dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnBiometric"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_button_outline"
                        android:text="Kiểm tra sinh trắc học"
                        android:textAllCaps="false"
                        android:textColor="@color/cinema_text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/rowEditProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_panel_luxe"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Chỉnh sửa hồ sơ"
                android:textColor="@color/cinema_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/rowVoucher"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_panel_luxe"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Kho voucher"
                android:textColor="@color/cinema_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/rowHistory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_panel_luxe"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Lịch sử mua vé"
                android:textColor="@color/cinema_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/rowTerms"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_panel_luxe"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Điều khoản sử dụng"
                android:textColor="@color/cinema_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/rowPrivacy"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_panel_luxe"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Chính sách quyền riêng tư"
                android:textColor="@color/cinema_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvBackToLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_outline"
                android:gravity="center"
                android:text="Đăng xuất"
                android:textColor="@color/cinema_accent"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_bottom_nav_luxe"
        app:itemIconTint="@color/nav_icon_selector"
        app:itemTextColor="@color/nav_text_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />
</LinearLayout>
