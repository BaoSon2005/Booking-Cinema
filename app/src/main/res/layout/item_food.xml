<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/cinema_panel"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/cinema_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgFood"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:contentDescription="Hình bắp nước"
            android:scaleType="centerCrop"
            android:src="@drawable/logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFoodName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Combo bắp nước"
                android:textColor="@color/cinema_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFoodDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:text="Bắp caramel và nước ngọt"
                android:textColor="@color/cinema_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvFoodPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="89.000đ"
                android:textColor="@color/cinema_gold"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnMinusFood"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_outline"
                android:contentDescription="Giảm số lượng"
                android:padding="8dp"
                android:src="@android:drawable/ic_delete"
                app:tint="@color/cinema_accent" />

            <TextView
                android:id="@+id/tvFoodQuantity"
                android:layout_width="32dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/cinema_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnPlusFood"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_neon"
                android:contentDescription="Tăng số lượng"
                android:padding="8dp"
                android:src="@android:drawable/ic_input_add"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
