<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chooseSeatLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#222222"
    android:padding="16dp">

    <!-- Tiêu đề -->
    <TextView
        android:id="@+id/tvChooseSeatTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎟️ Chọn Ghế Ngồi"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#E50914"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- Thông tin ghế đã chọn -->
    <TextView
        android:id="@+id/txtSeatPriceDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bạn chưa chọn ghế nào"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:padding="8dp"
        android:background="#333333"
        android:layout_marginBottom="12dp" />

    <!-- Màn hình mô phỏng -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="📽️ MÀN HÌNH"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="#000000"
        android:background="#C8E6C9"
        android:layout_marginBottom="12dp" />

    <!-- Ghế: ScrollView ngang và dọc -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <GridLayout
                android:id="@+id/gridSeats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="14"
                android:rowCount="12"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="true"
                android:padding="8dp" />
        </ScrollView>
    </HorizontalScrollView>

    <!-- Huy hiệu màu ghế (dọc) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/legendLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:divider="?android:attr/dividerHorizontal"
            android:showDividers="middle"
            android:dividerPadding="8dp">

            <!-- Item mẫu (dùng cho từng loại ghế) -->
            <!-- Thường -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:layout_marginEnd="8dp">

                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="#BFBFBF"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thường"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Couple -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:layout_marginEnd="8dp">

                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="#FF69B4"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Couple"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Premium -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:layout_marginEnd="8dp">

                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="#00BCD4"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Premium"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Đã đặt -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:layout_marginEnd="8dp">

                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="#9E6E6E"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đã đặt"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Đã chọn -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp">

                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="#4CAF50"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đã chọn"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>


    <!-- Nút xác nhận -->
    <Button
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xác nhận"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E50914"
        android:padding="14dp" />
</LinearLayout>
