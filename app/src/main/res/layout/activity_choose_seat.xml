<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chooseSeatLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cinema_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_top_bar_luxe"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/cinema_text_muted"
            android:textSize="24sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CINE-LUXE"
            android:textColor="@color/cinema_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_icon_circle_luxe"
            android:gravity="center"
            android:text="⏱"
            android:textColor="@color/cinema_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvMovieTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Chọn ghế"
                android:textColor="@color/cinema_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCinemaTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Rạp • Suất chiếu"
                android:textColor="@color/cinema_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvHoldCountdown"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_voucher_luxe"
                android:gravity="center"
                android:text="Thời gian giữ ghế: 05:00"
                android:textColor="@color/cinema_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/cinema_panel"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/cinema_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_screen_luxe"
                        android:gravity="center"
                        android:text="MÀN HÌNH IMAX"
                        android:textColor="@color/cinema_bg"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="356dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_panel_glass">

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fillViewport="true"
                            android:overScrollMode="never">

                            <ScrollView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:fillViewport="true"
                                android:overScrollMode="never">

                                <GridLayout
                                    android:id="@+id/gridSeats"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:alignmentMode="alignMargins"
                                    android:columnCount="10"
                                    android:padding="10dp"
                                    android:rowCount="8"
                                    android:useDefaultMargins="true" />
                            </ScrollView>
                        </HorizontalScrollView>

                        <ProgressBar
                            android:id="@+id/progressBar"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/cinema_accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/bg_seat_available" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="Thường"
                            android:textColor="@color/cinema_text_muted"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_seat_vip" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="VIP"
                            android:textColor="@color/cinema_text_muted"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_seat_couple" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="Couple"
                            android:textColor="@color/cinema_text_muted"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_seat_booked" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="Đã đặt"
                            android:textColor="@color/cinema_text_muted"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/txtSeatPriceDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_panel_glass"
                android:lineSpacingExtra="3dp"
                android:padding="12dp"
                android:text="Bạn chưa chọn ghế nào"
                android:textColor="@color/cinema_text"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:background="@drawable/bg_sticky_checkout"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Giữ ghế"
            android:textColor="@color/cinema_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="178dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_button_neon"
            android:text="TIẾP TỤC"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
