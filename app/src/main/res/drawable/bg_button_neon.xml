<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#33FF0033" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape>
            <solid android:color="#FF0033" />
            <stroke
                android:width="1dp"
                android:color="#FFFF5C78" />
            <corners android:radius="16dp" />
            <padding
                android:left="18dp"
                android:top="12dp"
                android:right="18dp"
                android:bottom="12dp" />
        </shape>
    </item>
</layer-list>
